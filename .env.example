# Copy to .env for local development. Never commit .env.
# On Vercel, set this in Project Settings -> Environment Variables.

# Google AI Studio API key: https://aistudio.google.com/apikey
GEMINI_API_KEY="AIza..."

# Optional: override the model (defaults to gemini-flash-latest, which tracks
# the current stable Flash so it won't get gated out).
# GEMINI_MODEL="gemini-flash-latest"
