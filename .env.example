# Copy to .env for local development. Never commit .env.
# On Vercel, set these three in Project Settings -> Environment Variables.

# Vercel Postgres / Neon. Use the pooled connection string for the app.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# Vercel Blob store token (Storage -> Blob -> connect project).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Optional: override the model used for all Claude calls.
# ANTHROPIC_MODEL="claude-opus-4-8"
